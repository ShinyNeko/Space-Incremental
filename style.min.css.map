* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    width: 100%;
    height: 100%;

    font-family: Arial, Helvetica, sans-serif;
    font-size: 18px;

    color: #222;
    background: #eeeeee;
}

body {
    display: grid;

    grid-template-columns: 110px 1fr;
    grid-template-rows:
        25px      /* top bar */
        50px      /* headline */
        1fr;      /* content */
}

span.btn-line{
    display: block;
}

button {
    border-radius: 3px;
    /* Remove blue glow from button */
    outline: none;
    /* Set text and background colors */
    color: #000;
    background: #fff;
    /* Use pointer cursor */
    cursor: pointer;
    width: 250px;
    height: 40px;
    margin-bottom: 2px;
}

/* Apply this style while the button is clicked */
button:active{
    border-top: solid 2px #8f8f8f;
    border-left: solid 2px #8f8f8f;
}

/* =========================
   TOP BAR
   ========================= */

header {
    grid-column: 1 / 3;
    grid-row: 1;

    display: flex;
    align-items: center;

    border-bottom: 1px solid #8fa7b5;
    background: #e9e9e9;
}

.title {
    padding-left: 7px;
    flex-grow: 1;
}

.top-links {
    display: flex;
    height: 100%;
}

.top-links a {
    color: #222;
    text-decoration: none;

    padding: 2px 10px;
}

.top-links a:hover {
    background: #d6d6d6;
}


/* =========================
   HEADLINE
   ========================= */

.headline {
    grid-column: 1 / 3;
    grid-row: 2;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 24px;

    border-bottom: 1px solid #8fa7b5;
    background: #eeeeee;
}


/* =========================
   SIDEBAR / TABS
   ========================= */

.sidebar {
    grid-column: 1;
    grid-row: 3;

    border-right: 1px solid #8fa7b5;

    background: #e8e8e8;
}

.sidebar a {
    display: block;

    height: 24px;
    padding: 2px 7px;

    color: #222;
    text-decoration: none;

    border-bottom: 1px solid #8fa7b5;
}

.sidebar a.active {
    background: #7899b8;
}

.sidebar a:hover {
    background: #cfd8df;
}

.sidebar a.active:hover {
    background: #7899b8;
}


/* =========================
   MAIN CONTENT
   ========================= */

main {
    grid-column: 2;
    grid-row: 3;

    position: relative;

    background: #eeeeee;
}

.content {
    padding: 5px 10px;
}

.version {
    position: absolute;

    right: 8px;
    bottom: 0;

    font-size: 24px;
}